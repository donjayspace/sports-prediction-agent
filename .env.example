# Runtime
APP_ENV=development
LOG_LEVEL=info
TIMEZONE=UTC
SPORTS=football,basketball,tennis,table_tennis
LOOKAHEAD_HOURS=24
OUTPUT_DIR=reports

# AI providers
AI_PROVIDERS=gemini,grok
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

XAI_API_KEY=
XAI_MODEL=

AGENT_VERSION=0.1.0
MODEL_VERSION=dc-1.0.0

# ─── Collectors ───────────────────────────────────────────────────
SPORTSCORE_API_BASE=https://sportscore.com/api
THE_SPORTS_DB_API_BASE=https://www.thesportsdb.com/api/v1/json/3
SPORTS_DATA_API_KEY=
NEWS_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_prediction_agent
REDIS_URL=redis://localhost:6379

# ─── apps/api ─────────────────────────────────────────────────────
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
AGENT_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-string

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# ─── apps/dashboard ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

