# Runtime
APP_ENV=development
TIMEZONE=UTC
SPORTS=football,basketball,tennis,table_tennis
LOOKAHEAD_HOURS=24
OUTPUT_DIR=reports

# AI providers
AI_PROVIDERS=gemini,grok
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Optional structured sports data providers
SPORTS_DATA_API_KEY=
NEWS_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_prediction_agent

# API
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
REDIS_URL=redis://localhost:6379
AGENT_BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
